{
  "name": "dsh-carlotta-theme",
  "version": "1.0.1",
  "private": true,
  "description": "鸣潮·珂莱塔主题：晶棱玫瑰（夜宴/白昼）、璀璨、休憩日、盛夏五套皮肤，全窗口换色、动态背景、启动画面，设置集成在 DSH 设置里，点 Q 版看 DeepSeek 余额与今日已用。非官方同人作品。",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/xunnian0721-code/dsh-carlotta-theme.git" },
  "type": "module",
  "main": "lib/index.js",
  "icon": "./assets/img/crest.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/img/crest.svg"
  },
  "files": [
    "lib/**/*.js",
    "assets/**/*",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "theme", "carlotta", "wuthering-waves"],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "test": "node --check lib/index.js && node --check lib/client.js && node test/host.test.mjs"
  }
}
